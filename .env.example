# Copie para .env e informe um token de leitura, ou deixe vazio para usar hf auth login ou acesso anônimo.
HF_TOKEN=
# Defina como 0 para não usar o modo de alto desempenho.
HF_XET_HIGH_PERFORMANCE=1
# Para usar apenas arquivos locais, defina 1 antes de iniciar o programa.
HF_HUB_OFFLINE=0
# Para desabilitar o Xet e usar HTTP, defina 1.
HF_HUB_DISABLE_XET=0

# --- Portabilidade e Aceleração de Hardware ---
# Backend para embeddings: auto | openvino | onnx | torch
EMB_BACKEND=auto
# Backend para LLM local: auto | openvino | onnx | torch
LLM_BACKEND=auto
# Dispositivo alvo de inferência: auto | CPU | GPU
DISPOSITIVO_IA=auto
# Precisão/quantização do LLM local: auto | fp32 | fp16 | int8 | int4
LLM_QUANTIZACAO=auto
# Modelo LLM local (vazio usa o padrão HuggingFaceTB/SmolLM2-1.7B-Instruct; ex.: Qwen/Qwen2.5-1.5B-Instruct)
LLM_MODEL=
