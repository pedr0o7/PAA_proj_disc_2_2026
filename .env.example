# Copie para .env e informe um token de leitura, ou deixe vazio para usar hf auth login ou acesso anônimo.
HF_TOKEN=
# Defina como 0 para não usar o modo de alto desempenho.
HF_XET_HIGH_PERFORMANCE=1
# Para usar apenas arquivos locais, defina 1 antes de iniciar o programa.
HF_HUB_OFFLINE=0
# Para desabilitar o Xet e usar HTTP, defina 1.
HF_HUB_DISABLE_XET=0
